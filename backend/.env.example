# Google AI Studio API Key (for hosted Gemma 4 / Gemini models)
GEMINI_API_KEY=

# Default Gemma model to request
DEFAULT_GEMMA_MODEL=gemini-2.0-flash

# Local Ollama connector settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2

# Server configuration
PORT=5000
DEBUG=True
REQUEST_TIMEOUT=15
